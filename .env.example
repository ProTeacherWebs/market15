DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client)
# Application type: Web application
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# legacy aliases (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_URL=http://localhost:3000

# Stripe (test mode). Live keys blocked unless PAYMENT_MODE=stripe_live
PAYMENT_MODE=stripe_test
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# сколько сумов = 1 USD для конвертации в Stripe (UZS Stripe не принимает)
STRIPE_UZS_PER_USD=12500
